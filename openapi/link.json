{
  "openapi": "3.1.0",
  "info": {
    "title": "kestrel link",
    "version": "0.1.0",
    "summary": "The connection between an Environment and the control plane.",
    "description": "The supervisor inside an Environment opens this connection outward: server-sent events down, POST up, plain HTTP with no protocol upgrade. Every Environment authenticates as the Run it is executing.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "{link}",
      "variables": {
        "link": {
          "default": "http://127.0.0.1:7717"
        }
      }
    }
  ],
  "security": [
    {
      "runCredential": []
    }
  ],
  "paths": {
    "/link/runs/{run}/entries": {
      "get": {
        "operationId": "entries",
        "summary": "Read one window of the Transcript of the Session this Run belongs to.",
        "description": "At most one window of entries, in order, and the cursor the next read resumes from. A cursor names a position rather than a read held open, so it still walks after the control plane restarts; one that names no position in this Transcript is refused rather than silently restarting the walk.",
        "parameters": [
          {
            "$ref": "#/components/parameters/run"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The cursor a previous read ended with. Absent means from the beginning.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "How many entries to return at most.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One window of the Transcript, and the cursor the next read resumes from.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Refused"
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "404": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/link/runs/{run}/instructions": {
      "get": {
        "operationId": "instructions",
        "summary": "Hold open the stream of instructions for a Run.",
        "description": "Replays every instruction after `Last-Event-ID`, then stays open. The stream closes when the Run ends.",
        "parameters": [
          {
            "$ref": "#/components/parameters/run"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "description": "The seq of the last instruction this Environment received. Absent means from the beginning.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The stream is open. Each event carries an instruction as its data, the instruction's kind as its event name, and its seq as its id.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Instruction"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "404": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/link/runs/{run}/reports": {
      "post": {
        "operationId": "report",
        "summary": "Report something about an Environment to the control plane.",
        "description": "Delivery is at-least-once: an Environment that loses the answer to a report sends it again under the same seq, and the control plane takes it once. A seq that skips one the Run has yet to report is refused.",
        "parameters": [
          {
            "$ref": "#/components/parameters/run"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The report was recorded, or had been already."
          },
          "400": {
            "$ref": "#/components/responses/Refused"
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "404": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "runCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "The credential issued for this Run when its Environment was provisioned, and invalidated when the Run ends."
      }
    },
    "parameters": {
      "run": {
        "name": "run",
        "in": "path",
        "required": true,
        "description": "The Run this Environment is executing.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Refused": {
        "description": "The link refused the request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Refusal"
            }
          }
        }
      }
    },
    "schemas": {
      "Instruction": {
        "description": "What the control plane asks of an Environment.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/Start"
          },
          {
            "$ref": "#/components/schemas/Stop"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "start": "#/components/schemas/Start",
            "stop": "#/components/schemas/Stop"
          }
        }
      },
      "Start": {
        "description": "Execute the Run this Environment was provisioned for.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "Stop": {
        "description": "Leave the link and exit.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "stop"
          }
        },
        "required": [
          "kind"
        ]
      },
      "Report": {
        "description": "What an Environment tells the control plane about itself. A report that belongs to its ordered account of the turn carries a seq and is taken once; what it says about itself costs nothing to take twice.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/Connected"
          },
          {
            "$ref": "#/components/schemas/Heartbeat"
          },
          {
            "$ref": "#/components/schemas/Started"
          },
          {
            "$ref": "#/components/schemas/Said"
          },
          {
            "$ref": "#/components/schemas/Used"
          },
          {
            "$ref": "#/components/schemas/Finished"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "connected": "#/components/schemas/Connected",
            "heartbeat": "#/components/schemas/Heartbeat",
            "started": "#/components/schemas/Started",
            "said": "#/components/schemas/Said",
            "used": "#/components/schemas/Used",
            "finished": "#/components/schemas/Finished"
          }
        }
      },
      "Connected": {
        "description": "The Environment is on the link, and this is what is running in it.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "connected"
          },
          "version": {
            "type": "string",
            "description": "The supervisor's version."
          }
        },
        "required": [
          "kind",
          "version"
        ]
      },
      "Heartbeat": {
        "description": "The Environment is still alive, and holds its Run's lease out for another turn of the clock. Sent for as long as the Run lasts; when it stops, the lease expires and the Run ends failed.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        },
        "required": [
          "kind"
        ]
      },
      "Started": {
        "description": "The Run has started.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "started"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "kind",
          "seq"
        ]
      },
      "Said": {
        "description": "What the Agent Runtime said, coalesced into one message at the end of a turn. An Agent's reasoning and its tool calls are the Run's business and are never reported.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "said"
          },
          "message": {
            "type": "string"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "kind",
          "seq",
          "message"
        ]
      },
      "Used": {
        "description": "What the Agent Runtime has spent so far. Recorded on the Run, and never in a Transcript.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "used"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "kind",
          "seq",
          "usage"
        ]
      },
      "Finished": {
        "description": "The Run is over, and this is how it went. The Environment exits after saying so.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "finished"
          },
          "exit": {
            "$ref": "#/components/schemas/Exit"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "kind",
          "seq",
          "exit"
        ]
      },
      "Seq": {
        "description": "Where a report sits in the sequence the Environment numbers. The control plane takes each number once, so a report replayed after an answer that never arrived changes the record once.",
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "Exit": {
        "description": "How a Run ended.",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "because": {
            "type": "string",
            "description": "Why it failed. Absent when it succeeded."
          }
        },
        "required": [
          "status"
        ]
      },
      "Usage": {
        "description": "Cumulative rather than per turn: the last report of it is the one that stands.",
        "type": "object",
        "properties": {
          "context_used": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens currently in context."
          },
          "context_size": {
            "type": "integer",
            "minimum": 0,
            "description": "The context window, in tokens."
          },
          "cost": {
            "type": "object",
            "description": "What it has cost so far. Absent when the runtime does not say.",
            "properties": {
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "description": "An ISO 4217 currency code."
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          }
        },
        "required": [
          "context_used",
          "context_size"
        ]
      },
      "Refusal": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "Page": {
        "description": "One bounded window of a Transcript, and where the next read resumes.",
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recorded"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the next read resumes. Null only for a read that started at the beginning and found nothing."
          },
          "more": {
            "type": "boolean",
            "description": "Whether entries were waiting beyond this window when it was read."
          }
        },
        "required": [
          "entries",
          "cursor",
          "more"
        ]
      },
      "Recorded": {
        "description": "One Transcript entry, and where it sits in the order.",
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "appended_at": {
            "type": "string",
            "format": "date-time"
          },
          "entry": {
            "$ref": "#/components/schemas/Entry"
          }
        },
        "required": [
          "seq",
          "appended_at",
          "entry"
        ]
      },
      "Entry": {
        "description": "What changed the Session's shared state. Never what happened inside a Run.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ParticipantJoined"
          },
          {
            "$ref": "#/components/schemas/RunStarted"
          },
          {
            "$ref": "#/components/schemas/Message"
          },
          {
            "$ref": "#/components/schemas/RunEnded"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "participant_joined": "#/components/schemas/ParticipantJoined",
            "run_started": "#/components/schemas/RunStarted",
            "said": "#/components/schemas/Message",
            "run_ended": "#/components/schemas/RunEnded"
          }
        }
      },
      "ParticipantJoined": {
        "description": "A Participant joined the Session.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "participant_joined"
          },
          "participant": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "participant"
        ]
      },
      "RunStarted": {
        "description": "A Run started on behalf of the Session.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "run_started"
          },
          "run": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "run"
        ]
      },
      "Message": {
        "description": "What a Participant said.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "said"
          },
          "participant": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "participant",
          "message"
        ]
      },
      "RunEnded": {
        "description": "A Run ended, and how it went.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "run_ended"
          },
          "run": {
            "type": "string",
            "format": "uuid"
          },
          "exit": {
            "$ref": "#/components/schemas/Exit"
          }
        },
        "required": [
          "kind",
          "run",
          "exit"
        ]
      }
    }
  }
}
